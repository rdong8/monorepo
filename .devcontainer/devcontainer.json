// clang-format off
// clang-format doesn't support JSON with comments
// Podman notes:
// - https://code.visualstudio.com/remote/advancedcontainers/docker-options#_podman
// - https://universal-blue.discourse.group/t/should-we-really-recommend-vscode-podman-as-supported/220/3
{
  //
  // GENERAL PROPERTIES: https://containers.dev/implementors/json_reference/#general-properties
  //
  "name": "Dev Container",
  "containerEnv": {
    // For Podman
    "HOME": "/home/dev"
  },
  // For Podman
  "remoteUser": "dev",
  "capAdd": [
    // For C++
    "SYS_PTRACE"
  ],
  "securityOpt": [
    // For C++
    "seccomp=unconfined",
    // For Podman
    "label=disable"
  ],
  "mounts": [
    {
      "source": "bazel",
      "target": "/home/dev/.cache/bazel",
      "type": "volume"
    },
    {
      "source": "bazelisk",
      "target": "/home/dev/.cache/bazelisk",
      "type": "volume"
    },
    {
      "source": "brew",
      "target": "/home/dev/.cache/Homebrew",
      "type": "volume"
    },
    {
      "source": "linuxbrew",
      "target": "/home/linuxbrew/.linuxbrew",
      "type": "volume"
    }
    // WARNING: it is not safe to use multiple concurrent sccache instances (ie. dev containers)
    // https://github.com/mozilla/sccache/blob/main/docs/Local.md#local
    // {
    //   "source": "sccache",
    //   "target": "/home/dev/.cache/sccache",
    //   "type": "volume"
    // },
    // For Python development
    // {
    //   "source": "uv",
    //   "target": "/home/dev/.cache/uv",
    //   "type": "volume"
    // }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // AI
        "google.google-antigravity",
        // Bazel
        "BazelBuild.vscode-bazel",
        // C++
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools-themes",
        // CMake
        "ms-vscode.cmake-tools",
        // Containers
        "docker.docker",
        "ms-azuretools.vscode-containers",
        // Doxygen
        "cschlosser.doxdocgen",
        // Git
        "eamodio.gitlens",
        // Just
        "nefrob.vscode-just-syntax",
        // Kubernetes
        // "ms-kubernetes-tools.vscode-kubernetes-tools",
        // LLVM
        "llvm-vs-code-extensions.lldb-dap",
        "llvm-vs-code-extensions.vscode-mlir",
        // Log files
        "iliazeus.vscode-ansi",
        // Manifest files
        "DavidAnson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        // Python
        "charliermarsh.ruff",
        "meta.pyrefly",
        "ms-python.isort",
        "ms-python.python",
        // "ktnrg45.vscode-cython",
        // "ms-toolsai.jupyter",
        // Rust
        // "rust-lang.rust-analyzer",
        // Web
        "denoland.vscode-deno",
        "ms-vscode.live-server"
      ]
    }
  },
  //
  // SCENARIO SPECIFIC PROPERTIES: https://containers.dev/implementors/json_reference/#general-properties
  //
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      // https://github.com/devcontainers/spec/issues/631
      // Run `id` on the host to get these
      "HOST_UID": "1000",
      "HOST_GID": "1000",
      "REMOTE_USER": "dev"
    }
  },
  "workspaceMount": "source=${localEnv:HOME}/projects,target=/home/dev/projects,type=bind,consistency=cached",
  "workspaceFolder": "/home/dev/projects/monorepo",
  "runArgs": [
    // For Podman
    "--userns=keep-id"
  ],
  //
  // LIFECYCLE SCRIPTS: https://containers.dev/implementors/json_reference/#lifecycle-scripts
  //
  "postCreateCommand": "${containerEnv:HOMEBREW_PREFIX}/bin/brew bundle --file=${containerWorkspaceFolder}/brew/Brewfile"
}
