load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = [
    "//docs:__pkg__",
    "//src:__subpackages__",
])

exports_files(["BUILD.bazel"])

gentbl_cc_library(
    name = "ToyOptionsTableGen",
    strip_include_prefix = "cli",
    tbl_outs = {"cli/ToyOptions.inc": ["-gen-opt-parser-defs"]},
    tblgen = "@llvm-project//llvm:llvm-min-tblgen",
    td_file = "cli/ToyOptions.td",
    deps = ["@llvm-project//llvm:OptParserTdFiles"],
)

cc_library(
    name = "toy",
    srcs = glob(
        include = ["**/*.cpp"],
        exclude = [
            "tests/",
            "main.cpp",
        ],
    ),
    hdrs = glob(
        include = ["**/*.hpp"],
        exclude = ["tests/"],
    ),
    implementation_deps = [
        "@cpptrace",
    ],
    module_interfaces = glob(
        include = ["**/*.cppm"],
        exclude = ["tests/"],
    ),
    deps = [
        ":ToyOptionsTableGen",
        "//src/utility",
        "@llvm-project//llvm:Option",
        "@llvm-project//llvm:Support",
        "@magic_enum",
        "@std_module",
    ],
)

cc_binary(
    name = "toyc",
    srcs = ["main.cpp"],
    deps = [
        ":toy",
        "@llvm-project//llvm:Support",
        "@std_module",
    ],
)
